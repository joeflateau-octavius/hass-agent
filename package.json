{
  "name": "hass-agent",
  "version": "1.0.0",
  "description": "macOS power and battery status agent for Home Assistant via MQTT",
  "main": "index.ts",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node --experimental-ffi --no-warnings --import tsx index.ts",
    "build": "node scripts/build-sea.mjs",
    "start": "./hass-agent",
    "test": "npm run ensure-data-dragon && npm run test:raw",
    "test:raw": "NODE_OPTIONS='--experimental-ffi --no-warnings' vitest run",
    "test:watch": "NODE_OPTIONS='--experimental-ffi --no-warnings' vitest",
    "typecheck": "tsc --noEmit",
    "ensure-data-dragon": "tsx scripts/ensure-data-dragon.ts",
    "update-data-dragon": "./hass-agent update-data-dragon",
    "release": "scripts/tag-release.sh ${RELEASE_TYPE:-patch}"
  },
  "keywords": [
    "home-assistant",
    "mqtt",
    "macos",
    "battery",
    "power",
    "system-monitor"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@types/winston": "^2.4.4",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "mqtt": "^5.14.0",
    "undici": "^8.10.0",
    "winston": "^3.17.0",
    "zod": "^4.0.14"
  },
  "engines": {
    "node": "26.7.0"
  },
  "os": [
    "darwin"
  ]
}
